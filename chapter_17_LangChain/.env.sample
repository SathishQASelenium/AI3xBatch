# ---------------------------------------------------------------------------
# Chapter 17 - LangChain Agents for QA + E2E QA Pipeline
# Copy this file to .env and fill in your keys. Never commit the filled-in
# file (.env is gitignored).
#
#   cp .env.sample .env        (macOS / Linux)
#   copy .env.sample .env      (Windows)
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# Groq - used by labs 001, 010 and the planner agent in 014
# Get a key at https://console.groq.com/keys
# ---------------------------------------------------------------------------
LLM_MODEL=openai/gpt-oss-120b
GROQ_API_KEY=

# ---------------------------------------------------------------------------
# Gemini - used by labs 002 and 004
# Get a key at https://aistudio.google.com/apikey
# ---------------------------------------------------------------------------
GEMINI_LLM_MODEL=google_genai:gemini-flash-lite-latest
GOOGLE_API_KEY=

# ---------------------------------------------------------------------------
# Ollama - used by lab 003 (local inference, no API key)
# Install from https://ollama.com and pull a model, e.g. `ollama pull gemma3:4b`
# ---------------------------------------------------------------------------
OLLAMA_MODEL=gemma3:4b

# ---------------------------------------------------------------------------
# OpenRouter - used by labs 011-014 (browser agent + executor)
# Get a key at https://openrouter.ai/keys
# deepseek/deepseek-chat is the default; gpt-oss-120b has more dependable
# function calling if DeepSeek dumps schemas as text.
# ---------------------------------------------------------------------------
OPENROUTER_LLM_MODEL=deepseek/deepseek-chat
OPENROUTER_LLM_API_KEY=

# ---------------------------------------------------------------------------
# Jira - used by labs 013 and 014 (REST v3 fetch)
# Create an API token at https://id.atlassian.com/manage-profile/security/api-tokens
# Lab 013 falls back to the bundled fixtures/ when Jira is unreachable.
# ---------------------------------------------------------------------------
JIRA_URL=https://your-domain.atlassian.net
JIRA_EMAIL=
JIRA_API_TOKEN=

# ---------------------------------------------------------------------------
# Target app - used by labs 012-014 (the app the browser agent drives)
# Defaults point at the TTACart demo app on The Testing Academy.
# ---------------------------------------------------------------------------
TARGET_APP_URL=https://app.thetestingacademy.com/playwright/ttacart/
TARGET_APP_USER=standard_user
TARGET_APP_PASS=tta_secret

# ---------------------------------------------------------------------------
# Slack - used by lab 014 (DUMMY MCP: messages are recorded, never sent)
# ---------------------------------------------------------------------------
SLACK_CHANNEL=#qa-automation

# ---------------------------------------------------------------------------
# Playwright - used by labs 010-014
# SLOW_MO_MS adds a fixed delay (ms) to every browser action so a human can
# watch a demo. Default 0 = run at full speed.
# ---------------------------------------------------------------------------
SLOW_MO_MS=0