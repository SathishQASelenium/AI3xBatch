# Maven / Java
target/
*.class
*.jar
*.war
*.log

# Python
__pycache__/
*.pyc
*.pyo
*.egg-info/
.pytest_cache/

# Python virtual environments (any chapter). venv writes its own .gitignore,
# but virtualenv/conda do not — keep these explicit.
.venv/
venv/
ENV/

# IDE
.idea/
.vscode/
*.iml
.project
.classpath
.settings/

# OS
.DS_Store
Thumbs.db

# Local Claude config (settings.local.json may contain credentials)
.claude/settings.local.json
CLAUDE.local.md

# IDE / editor scratch
.commandcode/
.env
env

# Secrets. .env.local is where `deepeval login` writes keys by default, and
# .deepeval/ is its JSON keystore — both hold plaintext API keys.
.env.local
.env.*.local
.deepeval/

# Local browser verification artifacts
.playwright-mcp/
.playwright-cli/

# CrewAI timestamped strategy outputs (regenerable; sample kept as chapter_12_CrewAI/test_strategy_output.md)
test_strategy_2*.md
chapter_12_CrewAI/test_strategy_2*.md
